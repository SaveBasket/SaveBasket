# SaveBasket owner authentication / database
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=use-a-long-random-initial-password
SESSION_SECRET=generate-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/db

# Sourcing engine
# Comma-separated HTTPS JSON feeds. Each feed may return an array, {offers:[...]}, or {products:[...]}.
# Required fields per offer: title/name and price. Recommended: source, url, condition, shipping, currency, availability, gtin/ean/upc.
SOURCING_FEED_URLS=https://partner.example.com/savebasket/offers.json
# Set to false only when at least one real authorised source is live.
SOURCING_DEMO_FALLBACK=true

# Keep retailer/marketplace API keys and affiliate secrets in Vercel Environment Variables.
# Never commit production credentials to GitHub.
